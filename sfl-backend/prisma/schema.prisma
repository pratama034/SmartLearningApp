generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  password_hash  String
  name           String
  role           String
  program_studi  String
  timezone       String         @default("Asia/Jakarta")
  tenant_id      String
  created_at     DateTime       @default(now()) @db.Timestamptz(3)
  study_blocks   StudyBlock[]
  focus_sessions FocusSession[]

  @@index([tenant_id])
  @@map("users")
}

model StudyBlock {
  id               String         @id @default(uuid()) @db.Uuid
  user_id          String         @db.Uuid
  type             String
  title            String
  description      String
  start_time       DateTime       @db.Time(0)
  end_time         DateTime       @db.Time(0)
  recurrence_rule  String?
  date             DateTime       @db.Date
  auto_focus       Boolean        @default(false)
  co_focus_enabled Boolean        @default(false)
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  focus_sessions   FocusSession[]

  @@index([user_id, date])
  @@map("study_blocks")
}

model FocusSession {
  id            String              @id @default(uuid()) @db.Uuid
  block_id      String              @db.Uuid
  user_id       String              @db.Uuid
  started_at    DateTime            @default(now()) @db.Timestamptz(3)
  ended_at      DateTime?           @db.Timestamptz(3)
  status        String              @default("active")
  ended_by      String?
  block         StudyBlock          @relation(fields: [block_id], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notifications NotificationEvent[]

  @@index([user_id, status])
  @@index([block_id])
  @@map("focus_sessions")
}

model NotificationEvent {
  id          String       @id @default(uuid()) @db.Uuid
  session_id  String       @db.Uuid
  source_id   String
  text        String
  received_at DateTime     @default(now()) @db.Timestamptz(3)
  passed      Boolean      @default(false)
  handled     Boolean      @default(false)
  session     FocusSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, received_at])
  @@map("notification_events")
}
